# Copy to `.env` (gitignored). Register a free OAuth App at
# https://github.com/settings/developers → "New OAuth App":
#   Homepage URL:               https://github.com/NouranAlSharawneh/vault
#   Authorization callback URL: https://github.com/NouranAlSharawneh/vault (unused, but required)
#   Enable Device Flow:         ✓ (required — this is how the app signs in)
#
# Only the client ID goes here. It is public by design. Never add the client secret:
# anything in the build can be pulled out of the .app, and the device flow doesn't need it.
MAIN_VITE_GITHUB_CLIENT_ID=
